{
  "name": "@wanyantiande/dsh-headroom",
  "version": "0.3.2",
  "packageManager": "pnpm@11.21.0",
  "license": "MIT",
  "type": "module",
  "description": "Headroom context-compression backend for DeepSeek Harness: local proxy lifecycle, a compaction engine backend, the headroom_retrieve CCR tool, and a settings card.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-token-meter": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-token-meter": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "jsdom": "^30.0.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0"
  }
}
