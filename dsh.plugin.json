{
  "id": "@wanyantiande/dsh-headroom",
  "version": "0.3.2",
  "main": "./lib/index.js",
  "description": "Headroom context-compression backend for DeepSeek Harness: local proxy lifecycle, a compaction engine backend, the headroom_retrieve CCR tool, and a settings card.",
  "client": {
    "main": "./lib/client.js",
    "inject": [
      "@deepseek-ai/dsh-client-store",
      "@deepseek-ai/dsh-client-locale",
      "@deepseek-ai/dsh-client-ui-settings",
      "@deepseek-ai/dsh-client-ui-primitives",
      "@deepseek-ai/dsh-client-ui-slots"
    ]
  },
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "contributes": {
    "tools": [
      "headroom_retrieve"
    ],
    "skills": []
  }
}
